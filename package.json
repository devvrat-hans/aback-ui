{
  "name": "aback-ui",
  "version": "0.1.0",
  "private": true,
  "description": "The building blocks behind better applications.",
  "license": "MIT",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @aback-ui/docs dev",
    "build": "bun run build:ui && bun run build:registry && bun run --filter @aback-ui/docs build",
    "build:ui": "bun --filter @aback-ui/ui build",
    "build:registry": "bun scripts/build-registry.mjs",
    "check:registry": "bun scripts/build-registry.mjs --check",
    "test": "bun --filter @aback-ui/ui test",
    "test:watch": "bun --filter @aback-ui/ui test:watch",
    "typecheck": "bun --filter @aback-ui/ui typecheck && bun --filter @aback-ui/docs typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "bun run typecheck && bun run lint && bun run test && bun run check:registry",
    "smoke:package": "bun scripts/check-package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
