{
  "name": "@aback-ui/ui",
  "version": "0.2.1",
  "description": "Accessible, square-cornered React components for the Aback design system.",
  "license": "MIT",
  "author": "Aback Group",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devvrat-hans/aback-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://abackui.com/docs/installation",
  "bugs": {
    "url": "https://github.com/devvrat-hans/aback-ui/issues"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist node_modules/.cache && tsc -p tsconfig.build.json && bun ../../scripts/fix-dist-extensions.mjs",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build && bun ../../scripts/verify-publishable.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.49.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "radix-ui": "^1.8.1",
    "react-day-picker": "^10.0.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "aback",
    "design-system",
    "react",
    "tailwindcss",
    "radix-ui"
  ]
}
