{
  "$schema": "node_modules/wrangler/config-schema.json",
  // abackui.com as a static-assets Worker. `bun run deploy` builds the
  // export into out/ and uploads it; there is no server code.
  "name": "aback-ui",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "routes": [{ "pattern": "abackui.com", "custom_domain": true }],
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
