{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abackui.com/schema/registry.json",
  "title": "Aback UI registry index",
  "description": "The list of installable items. Each entry has a matching {name}.json item file next to the index.",
  "type": "object",
  "required": ["name", "items"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string" },
    "homepage": { "type": "string", "format": "uri" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "type": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "categories": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "registryDependencies": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
