{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abackui.com/schema/registry-item.json",
  "title": "Aback UI registry item",
  "description": "One installable item: a component, block, utility, or theme file, with its source inlined. The aback-ui CLI reads this format.",
  "type": "object",
  "required": ["name", "type", "files"],
  "properties": {
    "$schema": { "type": "string" },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Kebab-case identifier used on the command line: aback-ui add <name>."
    },
    "type": {
      "enum": ["registry:ui", "registry:lib", "registry:file", "registry:style", "registry:block"]
    },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "npm packages the installed files import."
    },
    "devDependencies": { "type": "array", "items": { "type": "string" } },
    "registryDependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Other registry items installed first, by name or URL."
    },
    "categories": { "type": "array", "items": { "type": "string" } },
    "docs": { "type": "string", "format": "uri" },
    "meta": {
      "type": "object",
      "properties": {
        "status": { "enum": ["experimental", "beta", "stable", "deprecated"] },
        "usedIn": { "type": "array", "items": { "type": "string" } }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "content", "target"],
        "properties": {
          "path": { "type": "string" },
          "content": { "type": "string", "description": "The file source, written as-is." },
          "type": { "type": "string" },
          "target": {
            "type": "string",
            "description": "Where the file lands, relative to the project's components, lib, or styles directory."
          }
        }
      }
    }
  }
}
